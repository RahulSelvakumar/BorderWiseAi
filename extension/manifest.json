{
  "manifest_version": 3,
  "name": "BorderWise AI — Cross-Border Feasibility & Customs Calculator",
  "version": "1.0.0",
  "description": "Calculates landed cost, HS Code, domestic price arbitrage, and regulatory feasibility (WPC, BIS, EPR) for imported goods.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.com.au/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.es/*",
    "*://*.amazon.it/*",
    "*://*.amazon.sg/*",
    "*://*.alibaba.com/*",
    "*://*.aliexpress.com/*",
    "*://*.aliexpress.us/*",
    "*://*.bhphotovideo.com/*",
    "*://*.ebay.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.in/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.es/*",
        "*://*.amazon.it/*",
        "*://*.amazon.sg/*",
        "*://*.alibaba.com/*",
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.bhphotovideo.com/*",
        "*://*.ebay.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open BorderWise AI Import Assistant"
  }
}
